{
  "name": "agenttrail-kitchen",
  "version": "0.1.0-alpha.3",
  "type": "module",
  "description": "An experimental local 3D kitchen view for Agenttrail. Watch coding agents contribute to shared tasks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sodiumsun/agenttrail.git",
    "directory": "packages/kitchen"
  },
  "homepage": "https://github.com/sodiumsun/agenttrail/tree/main/docs/kitchen",
  "bugs": "https://github.com/sodiumsun/agenttrail/issues",
  "files": [
    "bin",
    "src",
    "public/build",
    "public/fonts",
    "public/index.html",
    "public/kitchen.css",
    "public/favicon.svg",
    "public/paper.svg",
    "docs/THIRD-PARTY.md",
    "docs/licenses",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "agenttrail-kitchen": "bin/office.mjs"
  },
  "scripts": {
